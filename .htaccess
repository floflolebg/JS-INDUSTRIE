# ================================================
# SÉCURITÉ - JS Industrie
# ================================================

# Désactiver l'affichage du listing des répertoires
Options -Indexes

# Protéger les fichiers sensibles
<FilesMatch "^(\.git|\.gitignore|\.htaccess|SECURITE\.md|README\.md|composer\.(json|lock)|package(-lock)?\.json)">
    Require all denied
</FilesMatch>

# Protéger le dossier data
<DirectoryMatch "^.*/data/.*">
    Require all denied
</DirectoryMatch>

# Bloquer l'accès aux fichiers de backup et temporaires
<FilesMatch "\.(bak|backup|old|tmp|log|sql|gz|zip)$">
    Require all denied
</FilesMatch>

# Bloquer l'accès aux fichiers de test et debug
<FilesMatch "^(test-|debug-|generate-|phpinfo)">
    Require all denied
</FilesMatch>

# ================================================
# HEADERS DE SÉCURITÉ
# ================================================

<IfModule mod_headers.c>
    # Protection XSS
    Header set X-XSS-Protection "1; mode=block"

    # Empêcher le MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Empêcher l'intégration dans des iframes
    Header always set X-Frame-Options "SAMEORIGIN"

    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self';"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Supprimer les informations de version du serveur
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ================================================
# FORCE HTTPS (décommenter en production avec SSL)
# ================================================

# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# ================================================
# TYPES MIME - FORCER LES BONS TYPES
# ================================================

<IfModule mod_mime.c>
    # CSS
    AddType text/css .css

    # JavaScript
    AddType application/javascript .js
    AddType application/x-javascript .js

    # Images
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/gif .gif
    AddType image/webp .webp
    AddType image/svg+xml .svg

    # Fonts
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/vnd.ms-fontobject .eot
    AddType font/ttf .ttf
    AddType font/otf .otf
</IfModule>

# ================================================
# COMPRESSION ET PERFORMANCE
# ================================================

<IfModule mod_deflate.c>
    # Compresser les fichiers texte
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    # Activer le cache navigateur
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Désactiver le cache pour le développement (à supprimer en production)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# ================================================
# PROTECTION CONTRE LES ATTAQUES
# ================================================

# Limite de taille des requêtes (10MB)
LimitRequestBody 10485760

# Protection contre les injections dans l'URL
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer les requêtes suspectes
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|[|%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|[|%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} (\.\./) [OR]
    RewriteCond %{QUERY_STRING} (javascript:|data:|vbscript:) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^e]*e)+mbed.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^o]*o)+bject.*(>|%3E) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# ================================================
# PAGE D'ERREUR PERSONNALISÉE
# ================================================

ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ================================================
# RÈGLES DE RÉÉCRITURE D'URL (optionnel)
# ================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rediriger www vers non-www (décommenter si nécessaire)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>
